{
  "version": "0.0.14",
  "scripts": {
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "dev": "parallelshell \"sass src/scss/main.scss build/main.css --style compressed --watch\" \"webpack -w\" \"gulp html\" \"gulp watch\"",
    "build": "npm run lint && sass src/scss/main.scss build/main.css --style compressed && gulp html && webpack",
    "bump-version": "node scripts/bump-version.js",
    "update-translations": "node scripts/update-translations.js"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.25",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^10.0.3",
    "gulp": "^5.0.0",
    "gulp-file-include": "^2.3.0",
    "parallelshell": "^3.0.1",
    "sass": "^1.98.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.99.8",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "break_eternity.js": "^2.1.3",
    "lodash": "^4.18.1"
  }
}
